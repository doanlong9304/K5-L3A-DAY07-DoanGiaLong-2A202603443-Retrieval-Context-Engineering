# Copy to .env (never commit .env).
# Day 6 PostgreSQL + pgvector (local-only lab password). Port 55633 because 55433 is in a
# Windows-reserved range on this machine; must match Day 6 docker-compose.override.yml.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55633/day6_lab
# Same key as Day 6; used for query embeddings (gemini-embedding-001, 768d).
GEMINI_API_KEY=
# Absolute path to the Day 6 starter/ folder; used by scripts/check_day6.py --start.
DAY6_STARTER_DIR=
# Agent LLM (claude-opus-5-5 via the Anthropic API); used by scripts/run_agent.py.
ANTHROPIC_API_KEY=
